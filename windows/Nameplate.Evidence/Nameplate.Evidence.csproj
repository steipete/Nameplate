<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../Nameplate.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../Nameplate.Core/Nameplate.Core.csproj" />
    <!-- Run the actual production windows and native positioning, with synthetic identity data. -->
    <Compile Include="../Nameplate.App/OverlayWindows.cs" Link="OverlayWindows.cs" />
    <Compile Include="../Nameplate.App/NativeMethods.cs" Link="NativeMethods.cs" />
  </ItemGroup>
</Project>
